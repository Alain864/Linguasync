# LinguaSync API - Standalone / Test Dockerfile
# Single-stage-ish build → optimized for testing
# All code + data dirs inside the container — no external volumes

FROM python:3.12-slim

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ENVIRONMENT=development

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Optional: MeCab + Japanese dictionaries (uncomment if needed)
# RUN apt-get update && apt-get install -y --no-install-recommends \
#     mecab \
#     libmecab-dev \
#     mecab-ipadic-utf8 \
#     && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install dependencies first (better caching)
COPY requirements-stage1.txt .
RUN pip install --no-cache-dir -r requirements-stage1.txt

# Optional MeCab python binding (if you enabled MeCab above)
# RUN pip install --no-cache-dir mecab-python3

# Copy application code
COPY subtitle_processor_v2.py .
COPY rag_engine_v2.py .
COPY learning_generator.py .
COPY api_v2.py .

# Create data directories inside the container
RUN mkdir -p data/subtitles data/processed \
    && mkdir -p chroma_db_v2

# ── Bake the data into the image ──
# Adjust source paths if your local folders are named differently
COPY data/processed_episodes_v2.json     /app/data/processed_episodes_v2.json
COPY chroma_db_v2/                       /app/chroma_db_v2/

# Copy .env if you have one (for local testing)
# In real usage → prefer -e OPENAI_API_KEY=... when running
COPY .env* ./

# Expose FastAPI port
EXPOSE 8000

# Healthcheck (same as original)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the API
CMD ["uvicorn", "api_v2:app", "--host", "0.0.0.0", "--port", "8000"]

# ────────────────────────────────────────────────
# Build & Run examples:
#
# 1. Build
#    docker build -t linguasync-api:test .
#
# 2. Run (basic)
#    docker run -p 8000:8000 \
#      -e OPENAI_API_KEY=sk-...your-key... \
#      linguasync-api:test
#
# 3. Run + name the container
#    docker run --name ls-api-test -p 8000:8000 \
#      -e OPENAI_API_KEY=sk-... \
#      linguasync-api:test
#
# 4. Test health endpoint
#    curl http://localhost:8000/health
#
# 5. Interactive shell (debugging)
#    docker run -it --rm -p 8000:8000 linguasync-api:test bash
#
# Note: All data written to chroma_db_v2/ and data/ will be lost when container is removed.
# This is intentional for a pure test image.
# ────────────────────────────────────────────────