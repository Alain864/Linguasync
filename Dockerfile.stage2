# LinguaSync API Stage 2 - Production Dockerfile
# Multi-stage build for optimized image

FROM python:3.12-slim as builder

# Install build dependencies including MeCab
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    mecab \
    libmecab-dev \
    mecab-ipadic-utf8 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install Python dependencies
COPY requirements-stage2.txt .
RUN pip install --no-cache-dir --user -r requirements-stage2.txt && \
    pip install --no-cache-dir --user mecab-python3


# Final stage
FROM python:3.12-slim

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/root/.local/bin:$PATH \
    ENVIRONMENT=production

# Install runtime dependencies including MeCab
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    mecab \
    libmecab2 \
    mecab-ipadic-utf8 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /root/.local /root/.local

# Copy application code
COPY subtitle_processor_v3.py .
COPY rag_engine_v3.py .
COPY learning_generator_v2.py .
COPY langgraph_orchestrator.py .
COPY api_v3.py .

# Expose FastAPI port
EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the API
CMD ["uvicorn", "api_v3:app", "--host", "0.0.0.0", "--port", "8000"]